{
  "name": "@v1nt1248/3nclient-lib",
  "license": "AGPL-3.0-or-later",
  "author": "v1nt1248",
  "version": "0.4.8",
  "description": "Library for 3NWeb clients",
  "type": "module",
  "files": [
    "dist",
    "src/components/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/ui3n-components.js",
  "module": "./dist/ui3n-components.js",
  "exports": {
    ".": {
      "import": "./dist/ui3n-components.js",
      "types": "./dist/src/ui3n-components.d.ts"
    },
    "./plugins": {
      "import": "./dist/ui3n-plugins.js",
      "types": "./dist/src/ui3n-plugins.d.ts"
    },
    "./utils": {
      "import": "./dist/ui3n-utils.js",
      "types": "./dist/src/ui3n-utils.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./variables.css": "./dist/variables.css",
    "./mixins.scss": "./dist/mixins.scss"
  },
  "scripts": {
    "dev": "vite",
    "clean:dist": "rm -rf dist/",
    "build": "pnpm clean:dist && vite build",
    "pack": "pnpm build && npm pack && cp *.tgz ./dist && rm *.tgz",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "stylelint": "stylelint --config .stylelint.config.cjs 'src/**/*.{vue,scss,css}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix 'src/**/*.{vue,scss,css}'",
    "lint": "pnpm eslint && pnpm stylelint",
    "lint:fix": "pnpm eslint:fix && pnpm stylelint:fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "eslint": "eslint src",
    "eslint:fix": "eslint --fix src"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@floating-ui/vue": "1.1.11",
    "dayjs": "1.11.23",
    "lodash": "4.18.1",
    "mitt": "3.0.1",
    "sanitize-html": "2.17.7",
    "vuedraggable": "4.1.0"
  },
  "peerDependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/lodash": "4.17.26",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-core": "3.5.43",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/runtime-core": "3.5.43",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jackspeak": "4.2.3",
    "jsdom": "30.1.2",
    "path": "0.12.7",
    "pinia": "3.0.4",
    "postcss-html": "1.8.1",
    "prettier": "3.9.10",
    "sass": "1.105.1",
    "shiki": "4.5.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-scss": "7.3.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.0.16",
    "vite-plugin-css-injected-by-js": "4.0.1",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitepress": "1.6.4",
    "vitest": "4.1.11",
    "vue": "3.5.43",
    "vue-component-meta": "3.3.12",
    "vue-docgen-api": "4.79.2",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  },
  "packageManager": "pnpm@12.6.0"
}

{
  "name": "@v1nt1248/3nclient-lib",
  "license": "AGPL-3.0-or-later",
  "author": "v1nt1248",
  "version": "0.4.17",
  "description": "Library for 3NWeb clients",
  "type": "module",
  "files": [
    "dist",
    "src/components/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/ui3n-components.js",
  "module": "./dist/ui3n-components.js",
  "exports": {
    ".": {
      "types": "./dist/src/ui3n-components.d.ts",
      "import": "./dist/ui3n-components.js"
    },
    "./plugins": {
      "types": "./dist/src/ui3n-plugins.d.ts",
      "import": "./dist/ui3n-plugins.js"
    },
    "./utils": {
      "types": "./dist/src/ui3n-utils.d.ts",
      "import": "./dist/ui3n-utils.js"
    },
    "./style.css": "./dist/style.css",
    "./variables.css": "./dist/variables.css",
    "./mixins.scss": "./dist/mixins.scss"
  },
  "scripts": {
    "dev": "vite",
    "clean:dist": "rm -rf dist/",
    "build": "pnpm clean:dist && vite build",
    "pack": "pnpm build && npm pack && cp *.tgz ./dist && rm *.tgz",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "stylelint": "stylelint --config .stylelint.config.cjs 'src/**/*.{vue,scss,css}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix 'src/**/*.{vue,scss,css}'",
    "lint": "pnpm eslint && pnpm stylelint",
    "lint:fix": "pnpm eslint:fix && pnpm stylelint:fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "eslint": "eslint src",
    "eslint:fix": "eslint --fix src"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@floating-ui/vue": "1.1.11",
    "@types/sanitize-html": "^2.16.2",
    "dayjs": "1.11.23",
    "imask": "7.6.1",
    "lodash": "4.18.1",
    "mitt": "3.0.1",
    "sanitize-html": "2.18.2",
    "vuedraggable": "4.1.0"
  },
  "peerDependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/compiler-core": "3.5.45",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/runtime-core": "3.5.45",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jackspeak": "4.2.3",
    "jsdom": "31.0.1",
    "path": "0.12.7",
    "pinia": "3.0.4",
    "postcss-html": "1.8.1",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "shiki": "4.6.0",
    "stylelint": "18.0.0",
    "stylelint-config-recommended-scss": "18.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-scss": "7.5.0",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-css-injected-by-js": "5.0.3",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-static-copy": "4.1.1",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitepress": "1.6.4",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-component-meta": "3.3.14",
    "vue-docgen-api": "4.79.2",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@12.6.0"
}
